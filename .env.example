# =================================================================
# ResearchMate Environment Configuration Template
# =================================================================

# Google AI Studio API Key (Required for Gemini Chat & Embeddings)
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Names
GEMINI_CHAT_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Embedding Vector Dimensions (3072 for gemini-embedding-2)
EMBEDDING_DIMENSIONS=3072

# Redis Vector Database Connection URL
# Local standalone: redis://localhost:6379
# Docker Compose:   redis://redis:6379
REDIS_URL=redis://localhost:6379

# Redis Index Basename Prefix
REDIS_INDEX_BASENAME=researchmate

# System Settings
TOKENIZERS_PARALLELISM=false
RESEARCHMATE_DEBUG=false
